{
  "permissions": {
    "allow": [
      "Bash(git -C /Users/chuckcatron/Code/test-ideas/lilbuddy log --oneline -5)",
      "Bash(git -C /Users/chuckcatron/Code/test-ideas/lilbuddy status)",
      "Bash(git -C /Users/chuckcatron/Code/test-ideas/lilbuddy diff --stat)",
