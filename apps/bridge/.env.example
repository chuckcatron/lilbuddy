# Bridge daemon configuration

# Convex deployment URL (required for forwarding)
CONVEX_SITE_URL=https://your-app.convex.cloud

# API key for authenticating with Convex HTTP endpoint (required for forwarding)
BRIDGE_API_KEY=your-bridge-api-key

# User ID sent with session state (optional, defaults to "")
BRIDGE_USER_ID=

# HTTP server port (optional, defaults to 8787)
PORT=8787

# Enable disk capture mode (optional, set to "true" or use --capture flag)
CAPTURE_MODE=false
